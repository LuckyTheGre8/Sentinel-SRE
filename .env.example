# Agent seeds (each 32+ chars, generated once via init)
ORCHESTRATOR_SEED=
TELEMETRY_SEED=
COMMIT_SEED=
SECURITY_SEED=
REMEDIATION_SEED=

# Agent ports
ORCHESTRATOR_PORT=8005
TELEMETRY_PORT=8001
COMMIT_PORT=8002
SECURITY_PORT=8003
REMEDIATION_PORT=8004

# Agent addresses (populated after first run, for orchestrator to know where to send)
TELEMETRY_ADDRESS=
COMMIT_ADDRESS=
SECURITY_ADDRESS=
REMEDIATION_ADDRESS=

# Shared
ASI1_API_KEY=
ASI1_DATA_SHARING=true
ASI1_MODEL=asi1-mini
GITHUB_TOKEN=
SENTINEL_REPOSITORIES=
SENTINEL_SENDERS=
SENTINEL_HEALTH_URLS=
AGENT_MAILBOX=true
AGENT_ENDPOINT=
AGENTVERSE_API_KEY=
LOG_LEVEL=INFO
